APP_NAME="Talent360"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# =========================================================
# BASE DE DATOS — PostgreSQL
# =========================================================
DB_CONNECTION=pgsql
DB_HOST=talent360_postgres
DB_PORT=5432
DB_DATABASE=talent360_saas
DB_USERNAME=postgres
DB_PASSWORD=Master

# =========================================================
# SESIONES, CACHE Y COLA
# =========================================================
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=redis

# =========================================================
# REDIS
# =========================================================
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# =========================================================
# LARAVEL REVERB (WebSockets en tiempo real)
# =========================================================
REVERB_APP_ID=talent360
REVERB_APP_KEY=talent360-key
REVERB_APP_SECRET=talent360-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# =========================================================
# SANCTUM (CORS y Autenticación)
# =========================================================
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:5173,127.0.0.1

# =========================================================
# GOOGLE GEMINI AI
# Obtén tu clave en: https://aistudio.google.com/app/apikey
# =========================================================
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.0-flash

# =========================================================
# FACTURAPI (Timbrado Electrónico de Nómina CFDI)
# Obtén tu clave en: https://www.facturapi.io/
# =========================================================
FACTURAPI_API_KEY=YOUR_FACTURAPI_KEY_HERE
FACTURAPI_MODE=sandbox

# =========================================================
# FIREBASE (Notificaciones Push FCM)
# Obtén las credenciales en: https://console.firebase.google.com/
# =========================================================
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
FIREBASE_SERVER_KEY=YOUR_FIREBASE_SERVER_KEY
FIREBASE_CREDENTIALS_PATH=storage/app/firebase-credentials.json

# =========================================================
# MERCADO PAGO / STRIPE (Pagos SaaS)
# =========================================================
MERCADOPAGO_ACCESS_TOKEN=YOUR_MP_ACCESS_TOKEN
MERCADOPAGO_PUBLIC_KEY=YOUR_MP_PUBLIC_KEY
STRIPE_KEY=YOUR_STRIPE_PUBLIC_KEY
STRIPE_SECRET=YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET

# =========================================================
# CORREO TRANSACCIONAL
# =========================================================
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@talent360.mx"
MAIL_FROM_NAME="Talent360"

# =========================================================
# ALMACENAMIENTO HETZNER (Storage Box / Local)
# =========================================================
STORAGE_DRIVER=local
HETZNER_STORAGE_KEY=YOUR_HETZNER_STORAGE_KEY

# =========================================================
# VARIABLES PÚBLICAS PARA EL FRONTEND
# =========================================================
VITE_APP_NAME="Talent360"
VITE_API_URL=http://localhost:8000/api

# Despliegue cross-domain (Railway+Vercel): 'None' para que la cookie httpOnly viaje
# entre dominios distintos (exige HTTPS/producción). Default: Lax (mismo dominio).
AUTH_COOKIE_SAMESITE=Lax

# Staging con APP_ENV=production (instancia V2): habilita el checkout SIMULADO.
# NUNCA en un servidor con clientes reales (un pago fingido aprovisiona planes).
ALLOW_SIMULATED_CHECKOUT=false
