# Copia de /etc/caddy/Caddyfile del servidor V2 (46.225.153.115).
# Se guarda aqui para que el certificado no dependa de que alguien recuerde como se configuro.
#
# 2026-08-28: HTTPS con certificado de IP pelada (perfil shortlived).
# 2026-09-04: se agrega talent360.com.mx + www con certificado NORMAL de 90 dias.
#             La IP se conserva a proposito: hay enlaces y marcadores que la usan.
#
# INSTALACION (Ubuntu 24.04, repo oficial de Caddy):
#   apt-get install -y debian-keyring debian-archive-keyring apt-transport-https curl
#   curl -1sLf https://dl.cloudsmith.io/public/caddy/stable/gpg.key | gpg --dearmor --yes -o /usr/share/keyrings/caddy-stable-archive-keyring.gpg
#   curl -1sLf https://dl.cloudsmith.io/public/caddy/stable/debian.deb.txt > /etc/apt/sources.list.d/caddy-stable.list
#   apt-get update && apt-get install -y caddy
#   # copiar este archivo a /etc/caddy/Caddyfile (sin esta cabecera)
#   caddy validate --config /etc/caddy/Caddyfile && systemctl enable --now caddy
#
# El DNS vive en GoDaddy: A @ y CNAME www -> 46.225.153.115.

# HTTPS de la instancia V2. ADITIVO: nada de lo existente se apaga
# (:3000 del dueno, :3002 la V2 directa, reverb 8081/8082).

# EL DOMINIO (2026-08-29). Certificado normal de Let's Encrypt, 90 dias, renovado
# solo por Caddy: sin bloque tls porque con nombre propio no hace falta el perfil
# de vida corta que exigia la IP pelada.
talent360.com.mx, www.talent360.com.mx {
	# Tiempo real (Reverb/Pusher): la pagina https abre wss al 443 y aqui se
	# enruta al 8082. Sin esto el navegador bloquea ws:// como contenido mixto
	# y el vivo muere EN SILENCIO, sin error en pantalla.
	@tiempo_real path /app /app/* /apps /apps/*
	reverse_proxy @tiempo_real localhost:8082

	# Web + API de una pieza: el bundle resuelve /api contra el mismo origen.
	reverse_proxy localhost:3002
}

# LA IP PELADA se conserva a proposito: hay enlaces, marcadores y una sesion de
# QA que la usan. Se queda con su certificado de vida corta (~6 dias), que es el
# unico que Let's Encrypt emite para una IP sin nombre.
46.225.153.115 {
	tls {
		issuer acme {
			profile shortlived
		}
	}

	@tiempo_real path /app /app/* /apps /apps/*
	reverse_proxy @tiempo_real localhost:8082

	reverse_proxy localhost:3002
}
